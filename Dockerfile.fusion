FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --timeout 120 --retries 10 --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple -r requirements.txt
# DINOv2 ViT-S/14 code at a pinned commit, and its pretrained weights, both checked by sha256.
RUN curl -sSL --retry 5 -o /tmp/dinov2.zip https://github.com/facebookresearch/dinov2/archive/7764ea0f912e53c92e82eb78a2a1631e92725fc8.zip \
 && echo "04276715cddb29d45d05bff3a6fc132224dc27749b279ac98ad2ce4620e20d48  /tmp/dinov2.zip" | sha256sum -c - \
 && unzip -q /tmp/dinov2.zip -d /opt && mv /opt/dinov2-7764ea0f912e53c92e82eb78a2a1631e92725fc8 /opt/dinov2 && rm /tmp/dinov2.zip \
 && curl -sSL --retry 5 -o /opt/dinov2_vits14_pretrain.pth https://dl.fbaipublicfiles.com/dinov2/dinov2_vits14/dinov2_vits14_pretrain.pth \
 && echo "b938bf1bc15cd2ec0feacfe3a1bb553fe8ea9ca46a7e1d8d00217f29aef60cd9  /opt/dinov2_vits14_pretrain.pth" | sha256sum -c -
COPY src/ src/
COPY weights/ weights/
# /data holds one folder per sample (challenge_test_set/vam-dataset-challenge_test_no_labels/data), with metadata.json and both videos. Output goes to /out.
ENTRYPOINT ["python", "src/infer.py", "--data_dir", "/data", "--out", "/out/submission.csv", "--k", "5", "--nms_iou", "0.6", "--models", "weights/fuse_full_s0.pt", "weights/fuse_full_s1.pt"]
